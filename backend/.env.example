# Application Settings
APP_NAME="NETRA Traffic Intelligence Backend"
APP_ENV="development"
DEBUG=true

# Database Settings (PostgreSQL + PostGIS)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/netra_db"

# Security & Authentication
SECRET_KEY="CHANGE_THIS_IN_DEVELOPMENT_TO_A_SUPER_SECRET_KEY"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# API Routing Prefix
API_V1_PREFIX="/api/v1"

# CORS Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
